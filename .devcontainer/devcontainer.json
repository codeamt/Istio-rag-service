{
  "name": "Enterprise RAG with Minikube", 
  "dockerComposeFile": "docker-compose.yml",
  "service": "rag-dev", 
  "workspaceFolder": "/workspace", 
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml", 
        "ms-python.python"
      ]
    }
  }, 
  "forwardPorts": [8080, 9090, 16686], //Istio, Prometheus, Jaeger
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode"
}
